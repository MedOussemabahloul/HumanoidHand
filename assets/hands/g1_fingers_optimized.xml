    <!-- Main droite -->
    <mesh name="right_thumb_0_mesh"  file="/content/HumanoidHand/assets/hands/meshes/right_thumb_1.STL"/>
    <mesh name="right_thumb_1_mesh"  file="/content/HumanoidHand/assets/hands/meshes/right_thumb_2.STL"/>

