    <!-- ========== POUCE GAUCHE ========== -->
    <body name="left_thumb_0" pos="0.02 0.04 0.015">
      <inertial pos="0.01 0 0" mass="0.015" diaginertia="1.3e-5 1.3e-5 1.3e-5"/>
