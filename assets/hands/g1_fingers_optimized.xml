    <!-- Capteurs de force simplifié (sans mesh pour éviter les conflits) -->
  </asset>

  <!-- ============================ OPTION COMPILER ============================ -->
  <option timestep="0.001" iterations="50" solver="Newton" tolerance="1e-10">
    <flag gravity="enable" contact="enable" frictionloss="enable"/>
  </option>

  <worldbody>
    <!-- ========== INDEX GAUCHE ========== -->
    <body name="left_index_0" pos="0.03 0.05 0.02">
      <inertial pos="0.01 0 0" mass="0.012" diaginertia="1e-5 1e-5 1e-5"/>
      <joint name="left_index_joint_0" type="hinge" axis="0 1 0"
             range="0 1.396" ref="0.1" springref="0.1" 
             damping="0.1" stiffness="2.0" frictionloss="0.01"/>
      <geom type="mesh" mesh="left_index_0_mesh"
            contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
      
      <body name="left_index_1" pos="0.02 0 0">
        <inertial pos="0.01 0 0" mass="0.008" diaginertia="8e-6 8e-6 8e-6"/>
        <joint name="left_index_joint_1" type="hinge" axis="0 1 0"
               range="0 1.222" ref="0.05" springref="0.05"
               damping="0.08" stiffness="1.5" frictionloss="0.008"/>
                 <geom type="mesh" mesh="left_index_1_mesh"
               contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
        
        <!-- Site tactile optimisé -->
        <site name="left_index_tip_site"
              pos="0.015 0 0" size="0.002" type="sphere"
              rgba="1 0 0 0.3"/>
      </body>
    </body>

    <!-- ========== MAJEUR GAUCHE ========== -->
    <body name="left_middle_0" pos="0.035 0.05 0.025">
      <inertial pos="0.01 0 0" mass="0.014" diaginertia="1.2e-5 1.2e-5 1.2e-5"/>
      <joint name="left_middle_joint_0" type="hinge" axis="0 1 0"
