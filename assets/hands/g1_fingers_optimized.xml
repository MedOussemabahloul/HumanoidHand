             damping="0.1" stiffness="2.0" frictionloss="0.01"/>
      <geom type="mesh" mesh="left_middle_0_mesh"
            contype="1" conaffinity="1" friction="0.8 0.005 0.0001"
           />
      
      <body name="left_middle_1" pos="0.02 0 0">
        <inertial pos="0.01 0 0" mass="0.009" diaginertia="9e-6 9e-6 9e-6"/>
        <joint name="left_middle_joint_1" type="hinge" axis="0 1 0"
               range="0 1.222" ref="0.05" springref="0.05"
               damping="0.08" stiffness="1.5" frictionloss="0.008"/>
        <geom type="mesh" mesh="left_middle_1_mesh"
              contype="1" conaffinity="1" friction="0.8 0.005 0.0001"
             />
        
        <site name="left_middle_tip_site"
              pos="0.015 0 0" size="0.002" type="sphere"
              rgba="1 0 0 0.3"/>
      </body>
    </body>

    <!-- ========== ANNULAIRE GAUCHE ========== -->
    <body name="left_ring_0" pos="0.04 0.05 0.025">
      <inertial pos="0.01 0 0" mass="0.013" diaginertia="1.1e-5 1.1e-5 1.1e-5"/>
