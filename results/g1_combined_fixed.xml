<?xml version='1.0' encoding='utf8'?>
<mujoco model="g1_combined_fixed">
  <compiler angle="radian" coordinate="local" />
  <option timestep="0.005" iterations="100" solver="PGS" tolerance="1e-8">
    <flag warmstart="enable" energy="enable" contact="enable" />
  </option>
  <size nconmax="500" njmax="3000" nstack="2000000" />
  
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.3 0.4 0.5" rgb2="0.2 0.3 0.4" markrgb="0.9 0.9 0.9" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.1" />
    <material name="table_mat" rgba="0.7 0.5 0.3 1" />
    <material name="cube_mat" rgba="0.1 0.7 0.1 1" />
  </asset>
  
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="0 0 -1" directional="true" exponent="1" pos="0 0 2" specular=".3 .3 .3" />
    <geom name="floor" size="2 2 0.02" type="plane" material="groundplane" />
    
    <!-- Table repositionnée plus proche du robot -->
    <body name="table" pos="0.35 0 0.01">
      <inertial pos="0 0 0" mass="50.0" diaginertia="5.0 5.0 1.0" />
      <geom name="table_top" type="box" size="0.25 0.2 0.015" material="table_mat" 
            friction="2.0 0.5 0.1" contype="1" conaffinity="1" />
      <geom name="table_leg1" type="cylinder" size="0.015 0.15" material="table_mat" 
            pos="0.2 0.15 -0.15" contype="1" conaffinity="1" />
      <geom name="table_leg2" type="cylinder" size="0.015 0.15" material="table_mat" 
            pos="0.2 -0.15 -0.15" contype="1" conaffinity="1" />
      <geom name="table_leg3" type="cylinder" size="0.015 0.15" material="table_mat" 
            pos="-0.2 0.15 -0.15" contype="1" conaffinity="1" />
      <geom name="table_leg4" type="cylinder" size="0.015 0.15" material="table_mat" 
            pos="-0.2 -0.15 -0.15" contype="1" conaffinity="1" />
    </body>
    
    <!-- Cube repositionné plus proche et accessible -->
    <body name="cube" pos="0.2 0 0.04">
      <freejoint name="cube_free" />
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" material="cube_mat" 
            friction="1.5 0.2 0.02" contype="2" conaffinity="2" />
      <inertial pos="0 0 0" mass="0.02" diaginertia="0.0005 0.0005 0.0005" />
    </body>
  </worldbody>
  
  <!-- Inclusion des fichiers de robot avec chemins relatifs -->
  <include file="./assets/hands/g1_body_fixed.xml"/>
  <include file="./assets/hands/g1_fingers_fixed.xml"/>
  
  <actuator>
    <!-- Actuators bras avec gains optimisés -->
    <position name="act_left_shoulder_pitch_joint" joint="left_shoulder_pitch_joint" gear="1" kp="20" kv="5" forcerange="-50 50" />
    <position name="act_left_shoulder_roll_joint" joint="left_shoulder_roll_joint" gear="1" kp="20" kv="5" forcerange="-50 50" />
    <position name="act_left_shoulder_yaw_joint" joint="left_shoulder_yaw_joint" gear="1" kp="20" kv="5" forcerange="-50 50" />
    <position name="act_left_elbow_joint" joint="left_elbow_joint" gear="1" kp="20" kv="5" forcerange="-40 40" />
    <position name="act_left_wrist_roll_joint" joint="left_wrist_roll_joint" gear="1" kp="15" kv="3" forcerange="-20 20" />
    <position name="act_left_wrist_pitch_joint" joint="left_wrist_pitch_joint" gear="1" kp="15" kv="3" forcerange="-20 20" />
    <position name="act_left_wrist_yaw_joint" joint="left_wrist_yaw_joint" gear="1" kp="15" kv="3" forcerange="-20 20" />
    
    <position name="act_right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint" gear="1" kp="20" kv="5" forcerange="-50 50" />
    <position name="act_right_shoulder_roll_joint" joint="right_shoulder_roll_joint" gear="1" kp="20" kv="5" forcerange="-50 50" />
    <position name="act_right_shoulder_yaw_joint" joint="right_shoulder_yaw_joint" gear="1" kp="20" kv="5" forcerange="-50 50" />
    <position name="act_right_elbow_joint" joint="right_elbow_joint" gear="1" kp="20" kv="5" forcerange="-40 40" />
    <position name="act_right_wrist_roll_joint" joint="right_wrist_roll_joint" gear="1" kp="15" kv="3" forcerange="-20 20" />
    <position name="act_right_wrist_pitch_joint" joint="right_wrist_pitch_joint" gear="1" kp="15" kv="3" forcerange="-20 20" />
    <position name="act_right_wrist_yaw_joint" joint="right_wrist_yaw_joint" gear="1" kp="15" kv="3" forcerange="-20 20" />
    
    <!-- Actuators doigts avec gains optimisés pour grasping -->
    <position name="act_left_index_joint_0" joint="left_index_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_left_index_joint_1" joint="left_index_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    <position name="act_left_middle_joint_0" joint="left_middle_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_left_middle_joint_1" joint="left_middle_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    <position name="act_left_ring_joint_0" joint="left_ring_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_left_ring_joint_1" joint="left_ring_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    <position name="act_left_thumb_joint_0" joint="left_thumb_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_left_thumb_joint_1" joint="left_thumb_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    
    <position name="act_right_index_joint_0" joint="right_index_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_right_index_joint_1" joint="right_index_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    <position name="act_right_middle_joint_0" joint="right_middle_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_right_middle_joint_1" joint="right_middle_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    <position name="act_right_ring_joint_0" joint="right_ring_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_right_ring_joint_1" joint="right_ring_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
    <position name="act_right_thumb_joint_0" joint="right_thumb_joint_0" gear="1" kp="12" kv="2" forcerange="-5 5" />
    <position name="act_right_thumb_joint_1" joint="right_thumb_joint_1" gear="1" kp="10" kv="1.5" forcerange="-3 3" />
  </actuator>
  
  <sensor>
    <!-- Sensors positions et vitesses optimisés -->
    <jointpos name="pos_left_shoulder_pitch_joint" joint="left_shoulder_pitch_joint" />
    <jointvel name="vel_left_shoulder_pitch_joint" joint="left_shoulder_pitch_joint" />
    <jointpos name="pos_left_shoulder_roll_joint" joint="left_shoulder_roll_joint" />
    <jointvel name="vel_left_shoulder_roll_joint" joint="left_shoulder_roll_joint" />
    <jointpos name="pos_left_shoulder_yaw_joint" joint="left_shoulder_yaw_joint" />
    <jointvel name="vel_left_shoulder_yaw_joint" joint="left_shoulder_yaw_joint" />
    <jointpos name="pos_left_elbow_joint" joint="left_elbow_joint" />
    <jointvel name="vel_left_elbow_joint" joint="left_elbow_joint" />
    <jointpos name="pos_left_wrist_roll_joint" joint="left_wrist_roll_joint" />
    <jointvel name="vel_left_wrist_roll_joint" joint="left_wrist_roll_joint" />
    <jointpos name="pos_left_wrist_pitch_joint" joint="left_wrist_pitch_joint" />
    <jointvel name="vel_left_wrist_pitch_joint" joint="left_wrist_pitch_joint" />
    <jointpos name="pos_left_wrist_yaw_joint" joint="left_wrist_yaw_joint" />
    <jointvel name="vel_left_wrist_yaw_joint" joint="left_wrist_yaw_joint" />
    
    <jointpos name="pos_right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint" />
    <jointvel name="vel_right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint" />
    <jointpos name="pos_right_shoulder_roll_joint" joint="right_shoulder_roll_joint" />
    <jointvel name="vel_right_shoulder_roll_joint" joint="right_shoulder_roll_joint" />
    <jointpos name="pos_right_shoulder_yaw_joint" joint="right_shoulder_yaw_joint" />
    <jointvel name="vel_right_shoulder_yaw_joint" joint="right_shoulder_yaw_joint" />
    <jointpos name="pos_right_elbow_joint" joint="right_elbow_joint" />
    <jointvel name="vel_right_elbow_joint" joint="right_elbow_joint" />
    <jointpos name="pos_right_wrist_roll_joint" joint="right_wrist_roll_joint" />
    <jointvel name="vel_right_wrist_roll_joint" joint="right_wrist_roll_joint" />
    <jointpos name="pos_right_wrist_pitch_joint" joint="right_wrist_pitch_joint" />
    <jointvel name="vel_right_wrist_pitch_joint" joint="right_wrist_pitch_joint" />
    <jointpos name="pos_right_wrist_yaw_joint" joint="right_wrist_yaw_joint" />
    <jointvel name="vel_right_wrist_yaw_joint" joint="right_wrist_yaw_joint" />
    
    <!-- Sensors doigts -->
    <jointpos name="pos_left_index_joint_0" joint="left_index_joint_0" />
    <jointvel name="vel_left_index_joint_0" joint="left_index_joint_0" />
    <jointpos name="pos_left_index_joint_1" joint="left_index_joint_1" />
    <jointvel name="vel_left_index_joint_1" joint="left_index_joint_1" />
    <jointpos name="pos_left_middle_joint_0" joint="left_middle_joint_0" />
    <jointvel name="vel_left_middle_joint_0" joint="left_middle_joint_0" />
    <jointpos name="pos_left_middle_joint_1" joint="left_middle_joint_1" />
    <jointvel name="vel_left_middle_joint_1" joint="left_middle_joint_1" />
    <jointpos name="pos_left_ring_joint_0" joint="left_ring_joint_0" />
    <jointvel name="vel_left_ring_joint_0" joint="left_ring_joint_0" />
    <jointpos name="pos_left_ring_joint_1" joint="left_ring_joint_1" />
    <jointvel name="vel_left_ring_joint_1" joint="left_ring_joint_1" />
    <jointpos name="pos_left_thumb_joint_0" joint="left_thumb_joint_0" />
    <jointvel name="vel_left_thumb_joint_0" joint="left_thumb_joint_0" />
    <jointpos name="pos_left_thumb_joint_1" joint="left_thumb_joint_1" />
    <jointvel name="vel_left_thumb_joint_1" joint="left_thumb_joint_1" />
    
    <jointpos name="pos_right_index_joint_0" joint="right_index_joint_0" />
    <jointvel name="vel_right_index_joint_0" joint="right_index_joint_0" />
    <jointpos name="pos_right_index_joint_1" joint="right_index_joint_1" />
    <jointvel name="vel_right_index_joint_1" joint="right_index_joint_1" />
    <jointpos name="pos_right_middle_joint_0" joint="right_middle_joint_0" />
    <jointvel name="vel_right_middle_joint_0" joint="right_middle_joint_0" />
    <jointpos name="pos_right_middle_joint_1" joint="right_middle_joint_1" />
    <jointvel name="vel_right_middle_joint_1" joint="right_middle_joint_1" />
    <jointpos name="pos_right_ring_joint_0" joint="right_ring_joint_0" />
    <jointvel name="vel_right_ring_joint_0" joint="right_ring_joint_0" />
    <jointpos name="pos_right_ring_joint_1" joint="right_ring_joint_1" />
    <jointvel name="vel_right_ring_joint_1" joint="right_ring_joint_1" />
    <jointpos name="pos_right_thumb_joint_0" joint="right_thumb_joint_0" />
    <jointvel name="vel_right_thumb_joint_0" joint="right_thumb_joint_0" />
    <jointpos name="pos_right_thumb_joint_1" joint="right_thumb_joint_1" />
    <jointvel name="vel_right_thumb_joint_1" joint="right_thumb_joint_1" />
    
    <!-- Sensors cube pour tracking -->
    <framepos name="cube_pos" objtype="body" objname="cube" />
    <framequat name="cube_quat" objtype="body" objname="cube" />
    <framelinvel name="cube_vel" objtype="body" objname="cube" />
  </sensor>
</mujoco>