<?xml version='1.0' encoding='utf-8'?>
<mujoco model="g1_manipulation_stable">
  <compiler angle="radian" coordinate="local" />
  <!-- CORRECTION 1: Paramètres de simulation optimisés pour stabilité -->
  <option timestep="0.005" iterations="100" solver="PGS" tolerance="1e-6">
    <flag warmstart="enable" energy="enable" />
  </option>
  <size nconmax="100" njmax="1000" nstack="600000" />
  
  <!-- CORRECTION 2: Paramètres par défaut optimisés -->
  <default>
    <joint damping="1.0" frictionloss="0.1" />
    <geom friction="1.0 0.1 0.1" />
    <!-- Paramètres spéciaux pour les doigts -->
    <default class="finger">
      <joint damping="5.0" frictionloss="0.5" stiffness="10" />
      <geom friction="1.5 0.2 0.2" />
    </default>
    <!-- Paramètres pour les bras -->
    <default class="arm">
      <joint damping="2.0" frictionloss="0.2" />
      <geom friction="1.0 0.1 0.1" />
    </default>
  </default>
  
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>
  
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    <body name="table" pos="0.5 0 0.01">
      <geom name="table_top" type="box" size="0.4 0.3 0.02" rgba="0.8 0.6 0.4 1" pos="0 0 0" />
      <geom name="table_leg1" type="box" size="0.02 0.02 0.2" rgba="0.6 0.4 0.2 1" pos="0.35 0.25 -0.2" />
      <geom name="table_leg2" type="box" size="0.02 0.02 0.2" rgba="0.6 0.4 0.2 1" pos="-0.35 0.25 -0.2" />
      <geom name="table_leg3" type="box" size="0.02 0.02 0.2" rgba="0.6 0.4 0.2 1" pos="0.35 -0.25 -0.2" />
      <geom name="table_leg4" type="box" size="0.02 0.02 0.2" rgba="0.6 0.4 0.2 1" pos="-0.35 -0.25 -0.2" />
    </body>
    <body name="cube" pos="0.3 0 0.05">
      <joint name="cube_free" type="slide" frictionloss="0.01" />
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" rgba="0.2 0.8 0.2 1" density="1000" friction="1 0.1 0.1" />
    </body>
  </worldbody>
  
  <include file="../assets/hands/g1_body_stable.xml" />
  <include file="../assets/hands/g1_fingers_stable.xml" />
  
  <actuator>
    <!-- Cube actuator -->
    <position name="act_cube_free" joint="cube_free" gear="1" kp="50" kv="5" />
    
    <!-- CORRECTION 3: Gains optimisés pour les bras -->
    <position name="act_left_shoulder_pitch_joint" joint="left_shoulder_pitch_joint" gear="1" kp="80" kv="8" class="arm" />
    <position name="act_left_shoulder_roll_joint" joint="left_shoulder_roll_joint" gear="1" kp="80" kv="8" class="arm" />
    <position name="act_left_shoulder_yaw_joint" joint="left_shoulder_yaw_joint" gear="1" kp="80" kv="8" class="arm" />
    <position name="act_left_elbow_joint" joint="left_elbow_joint" gear="1" kp="60" kv="6" class="arm" />
    <position name="act_left_wrist_roll_joint" joint="left_wrist_roll_joint" gear="1" kp="40" kv="4" class="arm" />
    <position name="act_left_wrist_pitch_joint" joint="left_wrist_pitch_joint" gear="1" kp="40" kv="4" class="arm" />
    <position name="act_left_wrist_yaw_joint" joint="left_wrist_yaw_joint" gear="1" kp="40" kv="4" class="arm" />
    
    <position name="act_right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint" gear="1" kp="80" kv="8" class="arm" />
    <position name="act_right_shoulder_roll_joint" joint="right_shoulder_roll_joint" gear="1" kp="80" kv="8" class="arm" />
    <position name="act_right_shoulder_yaw_joint" joint="right_shoulder_yaw_joint" gear="1" kp="80" kv="8" class="arm" />
    <position name="act_right_elbow_joint" joint="right_elbow_joint" gear="1" kp="60" kv="6" class="arm" />
    <position name="act_right_wrist_roll_joint" joint="right_wrist_roll_joint" gear="1" kp="40" kv="4" class="arm" />
    <position name="act_right_wrist_pitch_joint" joint="right_wrist_pitch_joint" gear="1" kp="40" kv="4" class="arm" />
    <position name="act_right_wrist_yaw_joint" joint="right_wrist_yaw_joint" gear="1" kp="40" kv="4" class="arm" />
    
    <!-- CORRECTION 4: Gains RÉDUITS pour les doigts -->
    <position name="act_left_index_joint_0" joint="left_index_joint_0" gear="1" kp="20" kv="3" class="finger" />
    <position name="act_left_index_joint_1" joint="left_index_joint_1" gear="1" kp="15" kv="2" class="finger" />
    <position name="act_left_middle_joint_0" joint="left_middle_joint_0" gear="1" kp="20" kv="3" class="finger" />
    <position name="act_left_middle_joint_1" joint="left_middle_joint_1" gear="1" kp="15" kv="2" class="finger" />
    <position name="act_left_ring_joint_0" joint="left_ring_joint_0" gear="1" kp="20" kv="3" class="finger" />
    <position name="act_left_ring_joint_1" joint="left_ring_joint_1" gear="1" kp="15" kv="2" class="finger" />
    <position name="act_left_thumb_joint_0" joint="left_thumb_joint_0" gear="1" kp="25" kv="4" class="finger" />
    <position name="act_left_thumb_joint_1" joint="left_thumb_joint_1" gear="1" kp="20" kv="3" class="finger" />
    
    <position name="act_right_index_joint_0" joint="right_index_joint_0" gear="1" kp="20" kv="3" class="finger" />
    <position name="act_right_index_joint_1" joint="right_index_joint_1" gear="1" kp="15" kv="2" class="finger" />
    <position name="act_right_middle_joint_0" joint="right_middle_joint_0" gear="1" kp="20" kv="3" class="finger" />
    <position name="act_right_middle_joint_1" joint="right_middle_joint_1" gear="1" kp="15" kv="2" class="finger" />
    <position name="act_right_ring_joint_0" joint="right_ring_joint_0" gear="1" kp="20" kv="3" class="finger" />
    <position name="act_right_ring_joint_1" joint="right_ring_joint_1" gear="1" kp="15" kv="2" class="finger" />
    <position name="act_right_thumb_joint_0" joint="right_thumb_joint_0" gear="1" kp="25" kv="4" class="finger" />
    <position name="act_right_thumb_joint_1" joint="right_thumb_joint_1" gear="1" kp="20" kv="3" class="finger" />
  </actuator>
  
  <sensor>
    <jointpos name="pos_cube_free" joint="cube_free" />
    <jointvel name="vel_cube_free" joint="cube_free" />
    
    <!-- Capteurs bras -->
    <jointpos name="pos_left_shoulder_pitch_joint" joint="left_shoulder_pitch_joint" />
    <jointvel name="vel_left_shoulder_pitch_joint" joint="left_shoulder_pitch_joint" />
    <jointpos name="pos_left_shoulder_roll_joint" joint="left_shoulder_roll_joint" />
    <jointvel name="vel_left_shoulder_roll_joint" joint="left_shoulder_roll_joint" />
    <jointpos name="pos_left_shoulder_yaw_joint" joint="left_shoulder_yaw_joint" />
    <jointvel name="vel_left_shoulder_yaw_joint" joint="left_shoulder_yaw_joint" />
    <jointpos name="pos_left_elbow_joint" joint="left_elbow_joint" />
    <jointvel name="vel_left_elbow_joint" joint="left_elbow_joint" />
    <jointpos name="pos_left_wrist_roll_joint" joint="left_wrist_roll_joint" />
    <jointvel name="vel_left_wrist_roll_joint" joint="left_wrist_roll_joint" />
    <jointpos name="pos_left_wrist_pitch_joint" joint="left_wrist_pitch_joint" />
    <jointvel name="vel_left_wrist_pitch_joint" joint="left_wrist_pitch_joint" />
    <jointpos name="pos_left_wrist_yaw_joint" joint="left_wrist_yaw_joint" />
    <jointvel name="vel_left_wrist_yaw_joint" joint="left_wrist_yaw_joint" />
    
    <jointpos name="pos_right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint" />
    <jointvel name="vel_right_shoulder_pitch_joint" joint="right_shoulder_pitch_joint" />
    <jointpos name="pos_right_shoulder_roll_joint" joint="right_shoulder_roll_joint" />
    <jointvel name="vel_right_shoulder_roll_joint" joint="right_shoulder_roll_joint" />
    <jointpos name="pos_right_shoulder_yaw_joint" joint="right_shoulder_yaw_joint" />
    <jointvel name="vel_right_shoulder_yaw_joint" joint="right_shoulder_yaw_joint" />
    <jointpos name="pos_right_elbow_joint" joint="right_elbow_joint" />
    <jointvel name="vel_right_elbow_joint" joint="right_elbow_joint" />
    <jointpos name="pos_right_wrist_roll_joint" joint="right_wrist_roll_joint" />
    <jointvel name="vel_right_wrist_roll_joint" joint="right_wrist_roll_joint" />
    <jointpos name="pos_right_wrist_pitch_joint" joint="right_wrist_pitch_joint" />
    <jointvel name="vel_right_wrist_pitch_joint" joint="right_wrist_pitch_joint" />
    <jointpos name="pos_right_wrist_yaw_joint" joint="right_wrist_yaw_joint" />
    <jointvel name="vel_right_wrist_yaw_joint" joint="right_wrist_yaw_joint" />
    
    <!-- Capteurs doigts -->
    <jointpos name="pos_left_index_joint_0" joint="left_index_joint_0" />
    <jointvel name="vel_left_index_joint_0" joint="left_index_joint_0" />
    <jointpos name="pos_left_index_joint_1" joint="left_index_joint_1" />
    <jointvel name="vel_left_index_joint_1" joint="left_index_joint_1" />
    <jointpos name="pos_left_middle_joint_0" joint="left_middle_joint_0" />
    <jointvel name="vel_left_middle_joint_0" joint="left_middle_joint_0" />
    <jointpos name="pos_left_middle_joint_1" joint="left_middle_joint_1" />
    <jointvel name="vel_left_middle_joint_1" joint="left_middle_joint_1" />
    <jointpos name="pos_left_ring_joint_0" joint="left_ring_joint_0" />
    <jointvel name="vel_left_ring_joint_0" joint="left_ring_joint_0" />
    <jointpos name="pos_left_ring_joint_1" joint="left_ring_joint_1" />
    <jointvel name="vel_left_ring_joint_1" joint="left_ring_joint_1" />
    <jointpos name="pos_left_thumb_joint_0" joint="left_thumb_joint_0" />
    <jointvel name="vel_left_thumb_joint_0" joint="left_thumb_joint_0" />
    <jointpos name="pos_left_thumb_joint_1" joint="left_thumb_joint_1" />
    <jointvel name="vel_left_thumb_joint_1" joint="left_thumb_joint_1" />
    
    <jointpos name="pos_right_index_joint_0" joint="right_index_joint_0" />
    <jointvel name="vel_right_index_joint_0" joint="right_index_joint_0" />
    <jointpos name="pos_right_index_joint_1" joint="right_index_joint_1" />
    <jointvel name="vel_right_index_joint_1" joint="right_index_joint_1" />
    <jointpos name="pos_right_middle_joint_0" joint="right_middle_joint_0" />
    <jointvel name="vel_right_middle_joint_0" joint="right_middle_joint_0" />
    <jointpos name="pos_right_middle_joint_1" joint="right_middle_joint_1" />
    <jointvel name="vel_right_middle_joint_1" joint="right_middle_joint_1" />
    <jointpos name="pos_right_ring_joint_0" joint="right_ring_joint_0" />
    <jointvel name="vel_right_ring_joint_0" joint="right_ring_joint_0" />
    <jointpos name="pos_right_ring_joint_1" joint="right_ring_joint_1" />
    <jointvel name="vel_right_ring_joint_1" joint="right_ring_joint_1" />
    <jointpos name="pos_right_thumb_joint_0" joint="right_thumb_joint_0" />
    <jointvel name="vel_right_thumb_joint_0" joint="right_thumb_joint_0" />
    <jointpos name="pos_right_thumb_joint_1" joint="right_thumb_joint_1" />
    <jointvel name="vel_right_thumb_joint_1" joint="right_thumb_joint_1" />
    
    <framepos name="cube_pos" objtype="body" objname="cube" />
    <framequat name="cube_quat" objtype="body" objname="cube" />
  </sensor>
</mujoco>