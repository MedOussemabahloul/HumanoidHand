<?xml version='1.0' encoding='utf8'?>
<mujoco model="g1_combined">
  <compiler angle="radian" coordinate="local" />
  <option timestep="0.005" iterations="50" solver="PGS" tolerance="1e-6" integrator="Euler">
    <flag warmstart="enable" energy="enable" contact="enable" />
  </option>
  <size nconmax="200" njmax="2000" nstack="1200000" />
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="table_mat" rgba="0.8 0.6 0.4 1" />
    <material name="cube_mat" rgba="0.2 0.8 0.2 1" />
  </asset>
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="0 0 1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    
    <!-- Caméra positionnée devant le robot et proche -->
    <camera name="front_camera" pos="0.8 0 0.6" xyaxes="0 -1 0 0.5 0 1" fovy="60" />
    <!-- Table stable et bien positionnée -->
    <body name="table" pos="0.5 0 0.4">
      <inertial pos="0 0 0" mass="50.0" diaginertia="5.0 5.0 1.0" />
      <geom name="table_top" type="box" size="0.3 0.2 0.02" material="table_mat" friction="2.0 0.5 0.1" contype="1" conaffinity="1" />
      <geom name="table_leg1" type="box" size="0.02 0.02 0.38" material="table_mat" friction="2.0 0.5 0.1" pos="0.25 0.15 -0.38" contype="1" conaffinity="1" />
      <geom name="table_leg2" type="box" size="0.02 0.02 0.38" material="table_mat" friction="2.0 0.5 0.1" pos="0.25 -0.15 -0.38" contype="1" conaffinity="1" />
      <geom name="table_leg3" type="box" size="0.02 0.02 0.38" material="table_mat" friction="2.0 0.5 0.1" pos="-0.25 0.15 -0.38" contype="1" conaffinity="1" />
      <geom name="table_leg4" type="box" size="0.02 0.02 0.38" material="table_mat" friction="2.0 0.5 0.1" pos="-0.25 -0.15 -0.38" contype="1" conaffinity="1" />
    </body>
    
    <!-- Cube proche du robot pour réduire la distance initiale -->
    <body name="cube" pos="0.35 0 0.44">
      <freejoint name="cube_free" />
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" material="cube_mat" friction="2.0 0.5 0.1" contype="2" conaffinity="2" density="300" />
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.0005 0.0005 0.0005" />
    </body>
  </worldbody>
  <include file="/home/oussema/Documents/project/assets/hands/g1_body_fixed.xml"/>
  <include file="/home/oussema/Documents/project/assets/hands/g1_fingers_fixed.xml"/>
